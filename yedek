/* =========================================================
   INITIALIZE
========================================================= */


async function initialize() {


  try {


    await loadSatelliteImagery();



    const response =

      await fetch(

        "https://raw.githubusercontent.com/holtzy/D3-graph-gallery/master/DATA/world.geojson"

      );


    if(
      !response.ok
    ) {


      throw new Error(

        "Country data could not load."

      );

    }


    const data =

      await response.json();


    countries =

      data.features;



    /*
    Draw strong borders.
    */


    drawWorldBorders();



    /*
    Default = Türkiye.
    */


    const turkey =

      countries.find(

        country =>

          normalize(

            countryName(
              country
            )

          )

          ===

          "turkey"

      );


    if(
      !turkey
    ) {


      throw new Error(

        "Türkiye was not found."

      );

    }


    await focusCountry(

      turkey,

      false

    );

  }


  catch(error) {


    showError(
      error
    );

  }

}



initialize();


